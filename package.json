{
  "name": "aero-sim",
  "version": "1.6.1",
  "private": true,
  "type": "module",
  "description": "Quadcopter drone flight simulator",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "setup:pyodide": "node scripts/copy-pyodide.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "predev": "npm run setup:pyodide",
    "dev": "vite",
    "prebuild": "npm run setup:pyodide && npm run check:i18n",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/lint": "6.9.8",
    "@codemirror/state": "6.7.6",
    "@codemirror/theme-one-dark": "6.1.3",
    "@codemirror/view": "6.43.15",
    "@fortawesome/fontawesome-free": "6.4.0",
    "codemirror": "6.0.2",
    "pyodide": "314.0.8",
    "three": "0.128.0"
  },
  "devDependencies": {
    "autoprefixer": "10.6.2",
    "postcss": "8.5.32",
    "tailwindcss": "3.4.19",
    "vite": "7.3.8"
  }
}
